# 大模型 OpenAI 兼容接口地址
BAILIAN_AI_URL='https://your-model-endpoint/v1'

# MySQL 连接（SQLAlchemy 异步驱动 aiomysql）
MYSQL_URL='mysql+aiomysql://root:你的密码@127.0.0.1:3306/ai'

# Redis 连接
REDIS_URL='redis://127.0.0.1:6379/0'

# MCP 客户端配置
# 传输方式：stdio（本地子进程）或 http（远程 streamable-http 端点）
MCP_TRANSPORT='stdio'
# stdio 方式：启动子进程的命令与参数（参数逗号分隔）
MCP_COMMAND='python'
MCP_ARGS='-m,your_mcp_server_module'
# http 方式：远程 MCP 端点地址
MCP_URL='http://127.0.0.1:8000/mcp'

# 注意：大模型 API Key 从系统环境变量 ai_key 读取，不要写进本文件
